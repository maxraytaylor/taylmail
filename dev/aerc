#!/usr/bin/env bash
# Start taylmail serve and aerc against dev/mailserver (run that first), with
# all state in dev/sandbox (gitignored). The daemon logs to
# dev/sandbox/serve.log and stops with aerc.
# Usage: dev/aerc        (dev/aerc --reset wipes taylmail's state first)
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
sandbox=$root/dev/sandbox
if [[ ${1:-} == --reset ]]; then rm -rf "$sandbox/state" "$sandbox/repo"; shift; fi
mkdir -p "$sandbox"

export TAYLMAIL_HOME=$sandbox/state
export TAYLMAIL_CWD=$sandbox/repo
export TAYLMAIL_ADDRESS=claude@taylmail.test
export TAYLMAIL_USERS=you@taylmail.test
export TAYLMAIL_IMAP=imap+insecure://127.0.0.1:1143
export TAYLMAIL_SMTP=smtp+insecure://127.0.0.1:1587
export TAYLMAIL_MAIL_PASSWORD_FILE=$sandbox/mail-password
# The dev SMTP sink records the envelope sender in Return-Path.
export TAYLMAIL_SENDER_CHECK=return-path
echo dev > "$TAYLMAIL_MAIL_PASSWORD_FILE"

# A small repo with a bug for the agent to fix.
if [[ ! -d $TAYLMAIL_CWD ]]; then
    git init -q -b main "$TAYLMAIL_CWD"
    git -C "$TAYLMAIL_CWD" config user.name Claude
    git -C "$TAYLMAIL_CWD" config user.email noreply@anthropic.com
    printf 'def add(a, b):\n    return a - b\n\n\ndef mul(a, b):\n    return a * b\n' \
        > "$TAYLMAIL_CWD/calc.py"
    git -C "$TAYLMAIL_CWD" add . && git -C "$TAYLMAIL_CWD" commit -qm "Add calc"
fi

# aerc refuses an accounts.conf readable by others.
umask 077
cat > "$sandbox/accounts.conf" <<CONF
[taylmail]
source   = imap+insecure://you%40taylmail.test:dev@127.0.0.1:1143
outgoing = smtp+insecure+none://127.0.0.1:1587
default  = INBOX
from     = You <you@taylmail.test>
CONF

cat > "$sandbox/aerc.conf" <<CONF
[ui]
threading-enabled = true
show-thread-context = true

[compose]
address-book-cmd =

[filters]
text/plain = colorize
.headers = colorize
CONF

"$root/.venv/bin/taylmail" serve >> "$sandbox/serve.log" 2>&1 &
serve=$!
trap 'kill $serve' EXIT
aerc -I -C "$sandbox/aerc.conf" -A "$sandbox/accounts.conf" "$@"
